# Copy to .env (gitignored) or inject via CI secrets / secrets Gradle plugin.
# Never commit real keys.

# OpenAI API credential (server/CI only; never embed in the Android APK)
# OPENAI_API_KEY=

# Optional Gemini / Firebase AI
# GEMINI_API_KEY=

# Google OAuth Web client ID (used by GoogleDriveAuth / requestIdToken)
# GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com
