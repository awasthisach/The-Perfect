# Copy to .env (gitignored) or inject via CI secrets / secrets Gradle plugin.
# Never commit real secrets (API keys, client_secret). OAuth client IDs are public identifiers.

# Optional Gemini / Firebase AI
# GEMINI_API_KEY=

# Google OAuth Web client ID used as serverClientId for Android ID-token requests.
# This is the Firebase-generated Web client in Google Cloud project thevvforg.
# Keep the Android OAuth client package com.vvf.smartmanager and its SHA-1 aligned
# with the actual signing certificate; the old embedded debug keystore was removed.
# Release/Play App Signing fingerprints must be verified from the real signing keys.
GOOGLE_WEB_CLIENT_ID="1058219630435-ltf8j7c0qui648k06as92k5upphuc6va.apps.googleusercontent.com"
