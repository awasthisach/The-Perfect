        "contentSyncTriggers": [
          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_file_fts_BEFORE_UPDATE BEFORE UPDATE ON `file_metadata` BEGIN DELETE FROM `file_fts` WHERE `docid`=OLD.`rowid`; END",
          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_file_fts_BEFORE_DELETE BEFORE DELETE ON `file_metadata` BEGIN DELETE FROM `file_fts` WHERE `docid`=OLD.`rowid`; END",
          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_file_fts_AFTER_UPDATE AFTER UPDATE ON `file_metadata` BEGIN INSERT INTO `file_fts`(`docid`, `name`, `path`, `tags`, `mimeType`, `contentText`) VALUES (NEW.`rowid`, NEW.`name`, NEW.`path`, NEW.`tags`, NEW.`mimeType`, NEW.`contentText`); END",
          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_file_fts_AFTER_INSERT AFTER INSERT ON `file_metadata` BEGIN INSERT INTO `file_fts`(`docid`, `name`, `path`, `tags`, `mimeType`, `contentText`) VALUES (NEW.`rowid`, NEW.`name`, NEW.`path`, NEW.`tags`, NEW.`mimeType`, NEW.`contentText`); END"
